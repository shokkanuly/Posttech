# Local synthetic demo. Copy this file to .env; never commit .env.
ENVIRONMENT=development
DEMO_MODE=true
DEMO_PASSWORD=Password123!
# Empty uses an ephemeral development key. Production MUST provide 32+ random characters.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# PostgreSQL is the main database: `docker compose up -d db` starts it on 127.0.0.1:5432.
POSTGRES_PASSWORD=janamen_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://janamen:janamen_local_only@127.0.0.1:5432/janamen
# SQLite still works for quick local experiments:
# DATABASE_URL=sqlite:///./janamen.db
# Same-origin needs no CORS. For a separate local frontend, use an explicit JSON list.
ALLOWED_ORIGINS=[]
# grounded_knowledge (offline) or gemini. Gemini needs GEMINI_API_KEY; never commit it.
AI_PROVIDER=grounded_knowledge
# Optional learned reranking; approval, role scope and evidence coverage always apply.
AI_RETRIEVAL_MODE=lexical
AI_RETRIEVAL_MODEL_PATH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Request rules
MAX_ADVANCE_AMOUNT=1000000
REQUEST_HORIZON_DAYS=365
# Public holidays of Kazakhstan are built in (app/leave_calendar.py) and never charged.
# Extra HR-approved non-working dates as JSON ISO dates, e.g. ["2026-06-01"].
LEAVE_EXCLUDED_DATES=[]
AI_CONFIDENCE_THRESHOLD=0.8
HR_SUPPORT_EMAIL=hr-support@janapost.kz
# Optional local reference simulation; never connects to a real service.
ENABLE_MOCK_INTEGRATIONS=false
# Maximum request body size, including streamed requests; 256 KiB by default.
MAX_REQUEST_BODY_BYTES=262144
# Integration gateway (docs/INTEGRATIONS.md). Empty URL: approvals queue nothing.
# Keys: 32+ random characters each, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
INTEGRATION_GATEWAY_URL=
INTEGRATION_OUTBOUND_KEY_ID=
INTEGRATION_OUTBOUND_KEY=
# JSON map key_id -> secret accepted from the gateway; keep two ids during rotation.
INTEGRATION_INBOUND_KEYS={}
# mTLS client certificate/key and the private CA of the gateway (required in production).
INTEGRATION_TLS_CERT=
INTEGRATION_TLS_KEY=
INTEGRATION_TLS_CA=
