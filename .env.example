# JanaMen Digital HR Configuration
PROJECT_NAME="JanaMen Digital HR"
API_V1_STR="/api/v1"
SECRET_KEY="synthetic-demo-secret-key-change-in-production-never-commit-secrets"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite by default for zero-config local run, or PostgreSQL in Docker
DATABASE_URL="sqlite:///./janamen.db"
# DATABASE_URL="postgresql://janamen_user:janamen_password@db:5432/janamen"

# Environment: development / production / test
ENVIRONMENT="development"

# AI Jana Settings
AI_PROVIDER="grounded_knowledge"
AI_CONFIDENCE_THRESHOLD=0.35
HR_SUPPORT_EMAIL="hr-support@janapost.kz"

# Mock Integration Adapters (1C:ZUP & Documentolog)
ENABLE_MOCK_INTEGRATIONS=true
MOCK_1C_BASE_URL="https://mock-1c.internal.janapost.kz"
MOCK_DOCUMENTOLOG_BASE_URL="https://mock-doclog.internal.janapost.kz"
