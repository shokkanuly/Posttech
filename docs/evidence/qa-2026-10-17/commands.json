{
  "runs": {
    "pip-check": {
      "command": ".venv/bin/python -m pip check",
      "executed": true,
      "exit_code": 0,
      "seconds": 0.24,
      "output": "pip-check.txt"
    },
    "targeted": {
      "command": ".venv/bin/python -m pytest -q tests/test_qa_acceptance.py tests/test_ai.py tests/test_ai_gemini.py tests/test_knowledge_files_and_ml.py",
